    "@phosphor-icons/react": "^2.1.10",
    "@privy-io/react-auth": "^3.52.1",
    "@privy-io/wagmi": "^4.0.20",
    "@tanstack/react-query": "^5.71.0",
    "@vire/agent": "workspace:*",
    "@vire/celo-infra": "workspace:*",
    "@vire/shared": "workspace:*",
    "@vire/textile": "workspace:*",
    "@x402/core": "^2.32.0",
    "@x402/evm": "^2.32.0",
    "@x402/next": "^2.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "viem": "^2.45.0",
    "wagmi": "^2.14.16",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.30.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
