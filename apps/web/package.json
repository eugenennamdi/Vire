{
  "name": "@vire/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "tsc -p ../../packages/shared/tsconfig.json && tsc -p ../../packages/celo-infra/tsconfig.json && tsc -p ../../packages/textile/tsconfig.json && tsc -p ../../packages/agent/tsconfig.json && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
