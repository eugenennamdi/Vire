# =============================================================================
# VIRE — Celo Mainnet (Chain ID 42220) Configuration
# Copy to .env and fill in values before mainnet deployment or live execution.
# NEVER commit .env or private keys.
# =============================================================================

# --- Celo Network & Attribution (ERC-8021) ---
CELO_CHAIN_ID=42220
CELO_RPC_URL=https://forno.celo.org
# Your official Loops House / Celo ERC-8021 attribution tag
VIRE_ATTRIBUTION_CODE=celo_55a64f75ba4a
# Pay agent gas in USD₮ via CIP-64 FeeCurrency Adapter (0x0E2A...6f72) when true
VIRE_USE_USDT_FEE_ABSTRACTION=false

# --- Deployed Contracts & Agent Identity (Celo Mainnet 42220) ---
VIRE_VAULT_ADDRESS=
VIRE_AGENT_ID=
# Public HTTPS URL of this app (used for ERC-8004 agentURI, OAuth, & x402)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Wallets (Keep owner & agent strictly separate!) ---
# Admin/deployer wallet that owns VireVault, creates/funds campaigns, and can pause()
VIRE_OWNER_PRIVATE_KEY=
# Dedicated settlementAgent EOA: Textile taker, Celo buy payer, ERC-8004 owner
VIRE_AGENT_PRIVATE_KEY=
# Comma-separated team/owner/agent wallets blocked from claiming contributor payouts
TEAM_WALLET_BLOCKLIST=

# --- Textile FX RFQ v2 (https://api.textilecredit.com/v2) ---
TEXTILE_API_BASE_URL=https://api.textilecredit.com/v2
# Ordinary Partner API key (tx_live_...) — required for includeAttribution + builderCodes
TEXTILE_API_KEY=

# --- Celo `buy` Agent Payments Gateway (https://gateway.usebuy.ai) ---
BUY_GATEWAY_URL=https://gateway.usebuy.ai
# Preferred settlement token on buy gateway: USDT | USDC | USAT
BUY_PAYMENT_TOKEN=USDT
# Max USD₮/USDC per single buy call (in USD string, e.g. "0.05")
BUY_MAX_AMOUNT_USD=0.05
# Set true ONLY for local offline dry runs without spending stablecoins
BUY_DRY_RUN=false
# Use paid Chainstack RPC via Celo `buy` for verification reads when true
BUY_USE_CHAINSTACK_RPC=false

# --- Celo Hosted x402 Facilitator (https://api.x402.celo.org) ---
X402_FACILITATOR_URL=https://api.x402.celo.org
# Mint once at https://x402.celo.org (sign in with GitHub for mainnet free credits)
X402_API_KEY=
# Your registered PayTo wallet receiving x402 endpoint fees
VIRE_X402_PAY_TO=
# Prices in USD₮ atomic units (6 decimals: 50000 = $0.05, 250000 = $0.25)
X402_VERIFY_PRICE_USDT_ATOMIC=50000
X402_CAMPAIGN_PRICE_USDT_ATOMIC=250000

# --- Contributor Identity Verification ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional GitHub token for higher API rate limits when inspecting PRs/issues
GITHUB_API_TOKEN=
# Signed session cookie secret (32+ random bytes hex)
SESSION_SECRET=

# --- Database (Drizzle + LibSQL / SQLite) ---
# Local zero-setup default; switch to libsql://... for Turso in production
DATABASE_URL=file:./data/vire.db
DATABASE_AUTH_TOKEN=

# --- Named Launch Partner (Drop-in Nigerian Gadget Retail Store Config) ---
NEXT_PUBLIC_PARTNER_NAME="Kano & Lagos Tech Hub (Pilot Partner)"
NEXT_PUBLIC_PARTNER_TAGLINE="Verified Black Friday & December Smartphone Micro-Affiliate Clearing"
NEXT_PUBLIC_PARTNER_LOGO_URL=""
NEXT_PUBLIC_PARTNER_HANDLE="@techhubng"
NEXT_PUBLIC_PARTNER_LOCATION="Lagos, Nigeria"
NEXT_PUBLIC_PARTNER_CAMPAIGN_BUDGET_USDT="500"
NEXT_PUBLIC_PARTNER_STORE_URL="https://example.com"
